<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0          http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.suez.keycloak</groupId>
    <artifactId>saml-rest-attribute-mapper</artifactId>
    <version>1.1.0</version>
    <packaging>jar</packaging>

    <name>SAML REST Attribute Mapper</name>
    <description>Custom Keycloak SAML mapper that fetches attributes from a REST API and maps JSON responses (object, array, or primitive) into SAML attributes dynamically.</description>
    <url>https://github.com/Suezenv/keycloak-saml-rest-attribute-mapper</url>

    <developers>
        <developer>
            <name>Walid Dhaoui</name>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>Unlicense</name>
            <url>https://unlicense.org</url>
        </license>
    </licenses>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <buildVersion>dev</buildVersion>

        <!-- Default Keycloak version -->
        <keycloak.version>26.5.5</keycloak.version>
    </properties>

    <!-- Profiles for different Keycloak versions -->
    <profiles>
        <profile>
            <id>keycloak-26.4.7</id>
            <properties><keycloak.version>26.4.7</keycloak.version></properties>
            <activation><activeByDefault>true</activeByDefault></activation>
        </profile>
        <profile>
            <id>keycloak-26.2.0</id>
            <properties><keycloak.version>26.2.0</keycloak.version></properties>
        </profile>
    </profiles>

    <dependencies>
        <!-- Core Keycloak -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-core</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Server SPI -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-server-spi</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Server SPI Private -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-server-spi-private</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Services (contains SAML mappers) -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-services</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- SAML Core -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-saml-core-public</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>saml-rest-attribute-mapper-${buildVersion}-kc-${keycloak.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
        </plugins>
    </build>
</project>
